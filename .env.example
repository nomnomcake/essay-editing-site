# Public site URL, used for metadata, sitemap and OG images. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cal.com handle or handle/event-type, e.g. "ameya/20min". Leave unset to show the email fallback.
NEXT_PUBLIC_CAL_LINK=

# Resend API key from resend.com. Leave unset locally and intake payloads are logged instead of emailed.
RESEND_API_KEY=

# Inbox that receives intake submissions.
INTAKE_TO_EMAIL=

# Sender address. Must be on a domain verified in Resend. Defaults to onboarding@resend.dev for testing.
INTAKE_FROM_EMAIL=
